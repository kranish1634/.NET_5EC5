using System;

namespace MarwadiUniversityAdmission
{
    class Student
    {
        // Private Data Members
        private string name;
		private string fatherName;
        private string motherName;
        private string gender;
		private int age;
        private string phoneNo;
        private string address;
        private string city;
        private string state;
        private string pincode;
        private double percentage;
        private string course;
        private double tuitionFee;
        private string hostelType;
        private double hostelFee;
        private double scholarship;
        private double totalFee;
		private string transportRoute;
        private double transportFee;

        // Constructor
        public Student(string name, double percentage, string fatherName, string motherName, string gender, 
                    string phoneNo, string address, string city, string state, string pincode, int age)
        {
           this.name = name;
           this.percentage = percentage;
           this.fatherName = fatherName;
           this.motherName = motherName;
           this.gender = gender;
           this.phoneNo = phoneNo;
           this.address = address;
           this.city = city;
           this.state = state;
           this.pincode = pincode;
           this.age = age;
       }
        // Check Eligibility
        public bool CheckEligibility()
        {
            if (percentage >= 50)
            {
                Console.WriteLine("\nStudent is Eligible for Admission.");
                return true;
            }
            else
            {
                Console.WriteLine("\nStudent is Not Eligible for Admission.");
                return false;
            }
        }

        // Select Course
        public void SelectCourse()
        {
          Console.WriteLine("\n========== Available Courses (Per Semester Fee) ==========");
          Console.WriteLine("1. B.Tech (Computer Engineering)   - Rs.60,000/Semester");
          Console.WriteLine("2. B.Tech (Information Technology) - Rs.58,000/Semester");
          Console.WriteLine("3. BCA                             - Rs.35,000/Semester");
          Console.WriteLine("4. MCA                             - Rs.45,000/Semester");
          Console.WriteLine("5. BBA                             - Rs.30,000/Semester");
          Console.WriteLine("6. MBA                             - Rs.55,000/Semester");
          Console.WriteLine("7. B.Com                           - Rs.25,000/Semester");
          Console.WriteLine("8. B.Sc (Computer Science)         - Rs.32,500/Semester");
          Console.WriteLine("9. B.Pharm                         - Rs.65,000/Semester");
          Console.WriteLine("10. Diploma Engineering            - Rs.27,500/Semester");
		    
          Console.Write("\nEnter Course Choice: ");
          int choice = Convert.ToInt32(Console.ReadLine());

          switch (choice)
          {
            case 1:
             course = "B.Tech (Computer Engineering)";
             tuitionFee = 60000;
            break;

            case 2:
             course = "B.Tech (Information Technology)";
             tuitionFee = 58000;
            break;

            case 3:
             course = "BCA";
             tuitionFee = 35000;
            break;

            case 4:
             course = "MCA";
             tuitionFee = 45000;
            break;

            case 5:
             course = "BBA";
             tuitionFee = 30000;
            break;

            case 6:
             course = "MBA";
             tuitionFee = 55000;
            break;

            case 7:
             course = "B.Com";
             tuitionFee = 25000;
            break;

            case 8:
             course = "B.Sc (Computer Science)";
             tuitionFee = 32500;
            break;

            case 9:
             course = "B.Pharm";
             tuitionFee = 65000;
            break;

            case 10:
             course = "Diploma Engineering";
             tuitionFee = 27500;
            break;
			
            default:
             Console.WriteLine("Invalid Course Selection!");
            return;
         }
        }

        // Scholarship
        public void CalculateScholarship()
        {
            if (percentage >= 90)
            {
                scholarship = tuitionFee;      // 100%
                Console.WriteLine("\nCongratulations! You received 100% Scholarship.");
            }
            else if (percentage >= 70 && percentage <= 85)
            {
                scholarship = tuitionFee * 0.20; // 20%
                Console.WriteLine("\nCongratulations! You received 20% Scholarship.");
            }
            else
            {
                scholarship = 0;
                Console.WriteLine("\nNo Scholarship.");
            }
        }

        // Hostel Selection
        public void SelectHostel()
        {
            Console.WriteLine("\n------ Hostel Options ------");
            Console.WriteLine("1. 4 Bed AC       - Rs.90,000");
            Console.WriteLine("2. 4 Bed Non-AC   - Rs.70,000");
            Console.WriteLine("3. 6 Bed AC       - Rs.75,000");
            Console.WriteLine("4. 6 Bed Non-AC   - Rs.55,000");
            Console.WriteLine("5. 8 Bed AC       - Rs.60,000");
            Console.WriteLine("6. 8 Bed Non-AC   - Rs.40,000");
            Console.WriteLine("7. No Hostel");

            Console.Write("\nEnter Hostel Choice: ");
            int h = Convert.ToInt32(Console.ReadLine());

            switch (h)
            {
                case 1:
                    hostelType = "4 Bed AC";
                    hostelFee = 90000;
                    break;
                case 2:
                    hostelType = "4 Bed Non-AC";
                    hostelFee = 70000;
                    break;
                case 3:
                    hostelType = "6 Bed AC";
                    hostelFee = 75000;
                    break;
                case 4:
                    hostelType = "6 Bed Non-AC";
                    hostelFee = 55000;
                    break;
                case 5:
                    hostelType = "8 Bed AC";
                    hostelFee = 60000;
                    break;
                case 6:
                    hostelType = "8 Bed Non-AC";
                    hostelFee = 40000;
                    break;
                case 7:
                    hostelType = "No Hostel";
                    hostelFee = 0;
                    break;
                default:
                    Console.WriteLine("Invalid Choice");
                    Environment.Exit(0);
                    break;
            }
        }
		public void SelectTransport()
       {
         Console.WriteLine("\n------ Transportation (Per Semester) ------");
         Console.WriteLine("1. Rajkot City Bus       - Rs.8,000");
         Console.WriteLine("2. Gondal Route          - Rs.12,000");
         Console.WriteLine("3. Morbi Route           - Rs.15,000");
         Console.WriteLine("4. Jamnagar Route        - Rs.18,000");
         Console.WriteLine("5. No Transport");

         Console.Write("\nEnter Transport Choice: ");
         int t = Convert.ToInt32(Console.ReadLine());

         switch (t)
         {
         case 1:
            transportRoute = "Rajkot City";
            transportFee = 8000;
            break;

         case 2:
            transportRoute = "Gondal";
            transportFee = 12000;
            break;

         case 3:
            transportRoute = "Morbi";
            transportFee = 15000;
            break;

         case 4:
            transportRoute = "Jamnagar";
            transportFee = 18000;
            break;

         case 5:
            transportRoute = "No Transport";
            transportFee = 0;
            break;

         default:
            Console.WriteLine("Invalid Choice");
            transportRoute = "No Transport";
            transportFee = 0;
            break;
         }
        }

       // Display Final Details
        public void DisplayDetails()
        {
           totalFee = (tuitionFee - scholarship) + hostelFee + transportFee;
           Console.WriteLine("\n=========================================================");
           Console.WriteLine("          MARWADI UNIVERSITY ADMISSION RECEIPT");
           Console.WriteLine("=========================================================");

           Console.WriteLine("Student Name        : " + name);
           Console.WriteLine("Father's Name       : " + fatherName);
           Console.WriteLine("Mother's Name       : " + motherName);
           Console.WriteLine("Gender              : " + gender);
           Console.WriteLine("Age                 : " + age);
           Console.WriteLine("Phone Number        : " + phoneNo);
           Console.WriteLine("Address             : " + address);
           Console.WriteLine("City                : " + city);
           Console.WriteLine("State               : " + state);
           Console.WriteLine("Pincode             : " + pincode);
           Console.WriteLine("12th Percentage     : " + percentage + "%");

           Console.WriteLine("---------------------------------------------------------");

           Console.WriteLine("Selected Course     : " + course);
           Console.WriteLine("Semester Fee        : Rs." + tuitionFee);
           Console.WriteLine("Scholarship         : Rs." + scholarship);
           Console.WriteLine("Hostel              : " + hostelType);
           Console.WriteLine("Hostel Fee          : Rs." + hostelFee);
           Console.WriteLine("Transport           : " + transportRoute);
           Console.WriteLine("Transport Fee       : Rs." + transportFee);

           Console.WriteLine("---------------------------------------------------------");
           Console.WriteLine("Total Payable Fee   : Rs." + totalFee);
           Console.WriteLine("=========================================================");
           Console.WriteLine("Admission Successfully Confirmed.");
           Console.WriteLine("=========================================================");
        }
    }

  class Program
  {
   static void Main(string[] args)
   {
    Console.WriteLine("========= MARWADI UNIVERSITY ADMISSION SYSTEM =========");


    // Student Name Validation
    string name;
    do
    {
        Console.Write("Enter Student Name : ");
        name = Console.ReadLine();

        if (string.IsNullOrWhiteSpace(name))
            Console.WriteLine("Name cannot be empty.");

    } while (string.IsNullOrWhiteSpace(name));


    // Father Name Validation
    string father;
    do
    {
        Console.Write("Enter Father's Name : ");
        father = Console.ReadLine();

        if (string.IsNullOrWhiteSpace(father))
            Console.WriteLine("Father name cannot be empty.");

    } while (string.IsNullOrWhiteSpace(father));


    // Mother Name Validation
    string mother;
    do
    {
        Console.Write("Enter Mother's Name : ");
        mother = Console.ReadLine();

        if (string.IsNullOrWhiteSpace(mother))
            Console.WriteLine("Mother name cannot be empty.");

    } while (string.IsNullOrWhiteSpace(mother));


    // Gender Validation
    string gender;

    do
    {
        Console.Write("Enter Gender (Male/Female): ");
        gender = Console.ReadLine().ToLower();

        if (gender != "male" && gender != "female")
            Console.WriteLine("Only Male or Female allowed.");

    } while (gender != "male" && gender != "female");
   //age
   int age;

    do
    {
      Console.Write("Enter Age (16-30): ");

      if (!int.TryParse(Console.ReadLine(), out age))
      {
        age = 0;

      }

      if (age < 16 || age > 30)
      {
        Console.WriteLine("Invalid Age! Age should be between 16 and 30.");
      }

    } while (age < 16 || age > 30);
    // Phone Number Validation
    string phone;

    do
    {
        Console.Write("Enter Phone Number (10 digits): ");
        phone = Console.ReadLine();

        if (phone.Length != 10 || !long.TryParse(phone, out _))
            Console.WriteLine("Phone number must contain exactly 10 digits.");

    } while (phone.Length != 10 || !long.TryParse(phone, out _));


    // Address Details
    Console.Write("Enter Address : ");
    string address = Console.ReadLine();

    Console.Write("Enter City : ");
    string city = Console.ReadLine();

    Console.Write("Enter State : ");
    string state = Console.ReadLine();


    // Pincode Validation
    string pincode;

    do
    {
        Console.Write("Enter Pincode (6 digits): ");
        pincode = Console.ReadLine();

        if (pincode.Length != 6 || !int.TryParse(pincode, out _))
            Console.WriteLine("Pincode must contain exactly 6 digits.");

    } while (pincode.Length != 6 || !int.TryParse(pincode, out _));


    // Percentage Validation
    double percentage;

    do
    {
        Console.Write("Enter 12th Percentage (0-100): ");

        if (!double.TryParse(Console.ReadLine(), out percentage))
            percentage = -1;

        if (percentage < 0 || percentage > 100)
            Console.WriteLine("Percentage should be between 0 and 100.");

    } while (percentage < 0 || percentage > 100);



    // Object Creation
    Student s1 = new Student(name, percentage, father, mother, gender, phone, address, city, state, pincode, age);


    // Admission Process
    if (s1.CheckEligibility())
    {
        s1.SelectCourse();
        s1.CalculateScholarship();
        s1.SelectHostel();
        s1.SelectTransport();
        s1.DisplayDetails();
    }
   }
  }
    
}
