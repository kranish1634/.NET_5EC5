@model ProductCatalog.Models.Product

<!DOCTYPE html>
<html>
<head>
    <title>Add Product</title>
    <style>
        body {
            font-family: "Segoe UI", Roboto, Arial, sans-serif;
            background: #f7f9fc;
            color: #0f172a;
            margin: 24px;
        }

        .form-container {
            max-width: 640px;
            margin: 18px auto;
            background: #ffffff;
            padding: 18px 20px;
            border-radius: 8px;
            border: 1px solid #e6eef6;
            box-shadow: 0 6px 18px rgba(15,23,42,0.04);
        }

        h1 { margin-top: 0; font-size: 1.4rem; }

        label { display: block; margin: 10px 0 6px; font-weight: 600; }

        input[type="text"], input[type="number"], textarea {
            width: 100%;
            padding: 8px 10px;
            border: 1px solid #d6e6fb;
            border-radius: 6px;
            box-sizing: border-box;
            font-size: 0.95rem;
        }

        textarea { min-height: 100px; resize: vertical; }

        button[type="submit"] {
            margin-top: 12px;
            background: #0b5ed7;
            color: #fff;
            padding: 10px 14px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
        }

        button[type="submit"]:hover { background: #094eb4; }

        .back-link {
            display: inline-block;
            margin-top: 14px;
            color: #0b5ed7;
            text-decoration: none;
        }

        .validation { color: #b91c1c; font-size: 0.9rem; }
    </style>
</head>

<body>

    <div class="form-container">

        <h1>Add New Product</h1>

        <form asp-controller="Product"
              asp-action="Create"
              method="post">

            <label>Product Name</label>
            <input asp-for="Name" />
            <span class="validation" asp-validation-for="Name"></span>

            <label>Category</label>
            <input asp-for="Category" />
            <span class="validation" asp-validation-for="Category"></span>

            <label>Brand</label>
            <input asp-for="Brand" />
            <span class="validation" asp-validation-for="Brand"></span>

            <label>Price</label>
            <input asp-for="Price" type="number" step="0.01" />
            <span class="validation" asp-validation-for="Price"></span>

            <label>Stock</label>
            <input asp-for="Stock" type="number" />

            <label>Description</label>
            <textarea asp-for="Description"></textarea>

            <button type="submit">Add Product</button>

    </form>

    <br />

    <a asp-controller="Product"
       asp-action="Index">
        Back to Products
    </a>

</body>
</html>